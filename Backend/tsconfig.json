{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "bin/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}